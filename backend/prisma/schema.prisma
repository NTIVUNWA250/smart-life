// SMART LIFE — PostgreSQL schema (SRS §2.5: PostgreSQL only, no Supabase)
// All monetary values are integer Rwandan Francs (RWF).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  approver
  admin
}

enum TxnType {
  income
  expense
}

enum GoalStatus {
  active
  achieved
  failed
}

enum ApprovalKind {
  spending
  screentime
  goal_edit
}

enum Frequency {
  daily
  monthly
  yearly
}

enum ScreenTargetKind {
  app
  url
}

enum ActivityCategory {
  study
  work
  exercise
  meal
  sleep
  leisure
  chore
  social
  other
}

enum ApprovalStatus {
  pending
  approved
  denied
}

enum PeerRelationship {
  peer
  parent
}

enum LinkStatus {
  pending
  accepted
  rejected
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(student)
  isMinor      Boolean  @default(false)
  // MoMo MSISDN for the MTN Open API, AES-GCM encrypted at rest (NFR7). Null until
  // the user links a wallet; without it MTN has no account to be asked about.
  momoMsisdnEnc String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions       Transaction[]
  goals              Goal[]
  spendingLimits     SpendingLimit[]
  screenTimePolicies ScreenTimePolicy[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  financeProfile     FinanceProfile?
  timetableEntries   TimetableEntry[]

  // Peer links
  linksAsStudent  PeerLink[] @relation("StudentLinks")
  linksAsApprover PeerLink[] @relation("ApproverLinks")

  // Approvals
  approvalsRequested Approval[] @relation("Requester")
  approvalsToReview  Approval[] @relation("Approver")
}

model RefreshToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Transaction {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  type       TxnType
  amountRwf  Int
  category   String   @default("general")
  note       String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, occurredAt])
  // Supports income/expense aggregations (limits + analytics) which filter by type.
  @@index([userId, type, occurredAt])
}

model Goal {
  id        String     @id @default(uuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  targetRwf Int
  savedRwf  Int        @default(0)
  deadline  DateTime
  status    GoalStatus @default(active)
  // True for the savings goal auto-derived from the user's finance profile (FR3).
  isAuto    Boolean    @default(false)
  // Last time the goal *definition* (title/target/deadline) changed. Enforces the
  // once-per-calendar-month edit rule; null until the first approved edit.
  lastEditedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // active-goal lookups (spending-limit calc) filter by userId + status.
  @@index([userId, status])
}

// Income / expected-expenses captured at sign-up, used to auto-calculate the
// savings goal (FR3). Editable at most once per calendar month, like goals.
// Percentage-based monthly budget (FR3). Income is split into expected expenses,
// an unexpected-expense buffer (≤10%) and savings (≥30%, funds the goals). The
// chosen budget model seeds these; users may customise within those guardrails.
model FinanceProfile {
  id              String    @id @default(uuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String    @unique
  incomeRwf       Int
  incomeFrequency Frequency @default(monthly)
  // Identifier of the chosen budget model (e.g. "sixty_solution") or "custom".
  budgetModel     String    @default("sixty_solution")
  expectedPct     Int       @default(60)
  unexpectedPct   Int       @default(10)
  savingsPct      Int       @default(30)
  // Cadence the user states expected expenses in; display-only (budget is % based).
  expenseFrequency Frequency @default(monthly)
  // Big monthly expense (e.g. rent) paid as a lump on the heavy-spending day;
  // the remainder of expected expenses is spread across each day.
  heavyExpenseRwf Int       @default(0)
  heavyExpenseDay Int       @default(1) // day of month (1–28) for the lump payment
  // Extra daily allowance on weekends vs weekdays (weekdays are lowered to match).
  weekendBoostPct Int       @default(30)
  // Last definition change; enforces the once-per-month edit rule.
  lastEditedAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// A recurring activity in the user's weekly timetable (FR5: time management).
// Times are minutes-from-local-midnight; recurrence is a set of weekdays.
model TimetableEntry {
  id              String           @id @default(uuid())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  title           String
  category        ActivityCategory @default(other)
  notes           String?
  // Weekdays this repeats on: 0=Sunday … 6=Saturday. Non-empty.
  daysOfWeek      Int[]
  startMin        Int              // 0–1439, minutes from midnight (local)
  endMin          Int              // > startMin, ≤ 1440
  // Focus mode: while active, only allowedTargets stay enabled — everything else
  // is blocked (FR5 isolation).
  isolation       Boolean          @default(false)
  reminderEnabled Boolean          @default(true)
  // Lead time for the pre-activity reminder; at least 5 minutes.
  reminderLeadMin Int              @default(5)
  color           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  allowedTargets  TimetableAllowedTarget[]

  @@index([userId])
}

// An app/website permitted during an isolation activity (whitelist).
model TimetableAllowedTarget {
  id        String           @id @default(uuid())
  entry     TimetableEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId   String
  appOrSite String
  kind      ScreenTargetKind @default(url)
  label     String?

  @@index([entryId])
}

model SpendingLimit {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  periodStart DateTime
  periodEnd   DateTime
  limitRwf    Int
  spentRwf    Int      @default(0)
  // Ad-hoc income received this month; boosts the effective income (and savings).
  unexpectedIncomeRwf Int @default(0)
  isBlocked   Boolean  @default(false)
  // A peer/parent approval grants one over-limit expense (FR6). It is consumed by
  // the next expense that would otherwise be refused, so unlike isBlocked it is
  // never recomputed away.
  overridePending Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, periodStart])
}

model ScreenTimePolicy {
  id            String           @id @default(uuid())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  // Stable identifier: a host (kind=url) or an app package/bundle id (kind=app).
  appOrSite     String
  kind          ScreenTargetKind @default(url)
  // Human-friendly name shown in the UI (e.g. "Instagram"); falls back to appOrSite.
  label         String?
  dailyLimitMin Int
  usedMin       Int              @default(0)
  isBlocked     Boolean          @default(false)
  resetAt       DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, appOrSite])
  @@index([userId])
}

model PeerLink {
  id           String           @id @default(uuid())
  student      User             @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  approver     User             @relation("ApproverLinks", fields: [approverId], references: [id], onDelete: Cascade)
  approverId   String
  relationship PeerRelationship @default(peer)
  status       LinkStatus       @default(pending)
  createdAt    DateTime         @default(now())

  @@unique([studentId, approverId])
  @@index([approverId])
}

model Approval {
  id          String         @id @default(uuid())
  requester   User           @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String
  approver    User           @relation("Approver", fields: [approverId], references: [id], onDelete: Cascade)
  approverId  String
  kind        ApprovalKind
  targetId    String
  // Encrypted free-text reason / context (SRS §2.4 — encryption for peer requests)
  reasonEnc   String?
  // Encrypted JSON of the proposed change, applied on approval (kind=goal_edit).
  proposedEnc String?
  status      ApprovalStatus @default(pending)
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())

  @@index([approverId, status])
  @@index([requesterId])
}

model AuditLog {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  // Audit reporting filters/groups by action over time.
  @@index([action, createdAt])
}
